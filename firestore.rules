rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Texto não vazio (nome, e-mail, telefone, endereço, tokens,...).
    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Declara o tipo List das listas do documento. (Validação de tipos dos
    // elementos via list.all não existe na linguagem de regras; mantém-se o
    // tipo `is list`, mesmo padrão da regra original.)
    function isList(value) {
      return value is list;
    }

    // searchTokens do app é limitado a 150 (kMaxSearchTokens).
    function isValidSearchTokens(list) {
      return list is list && list.size() <= 150;
    }

    // Valida os campos sensíveis ao criar o usuário (doc completo).
    function isValidUserCreate() {
      return isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.email)
        && isNonEmptyString(request.resource.data.phone)
        && isNonEmptyString(request.resource.data.address);
    }

    // Valida o update do usuário por CAMPO PRESENTE no doc resultante.
    // Doc legado com campos faltando continua passando (login/merge).
    function hasValidUserFields(doc) {
      return (!('name' in doc) || isNonEmptyString(doc.name))
        && (!('email' in doc) || isNonEmptyString(doc.email))
        && (!('phone' in doc) || isNonEmptyString(doc.phone))
        && (!('address' in doc) || isNonEmptyString(doc.address))
        && (!('photoUrl' in doc) || doc.photoUrl is string)
        && (!('favoritePetIds' in doc) || isList(doc.favoritePetIds))
        && (!('myPublishedPetIds' in doc) || isList(doc.myPublishedPetIds))
        && (!('createdAt' in doc) || doc.createdAt is timestamp);
    }

    // Create de pet: exige doc completo (o app sempre grava tudo no create).
    function isValidPetCreate() {
      return isNonEmptyString(request.resource.data.ownerId)
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && isNonEmptyString(request.resource.data.ageUnit)
        && isNonEmptyString(request.resource.data.gender)
        && request.resource.data.images is list
        && isNonEmptyString(request.resource.data.publicationType)
        && isNonEmptyString(request.resource.data.race)
        && isNonEmptyString(request.resource.data.species)
        && isValidSearchTokens(request.resource.data.searchTokens)
        && request.resource.data.createdAt is timestamp;
    }

    // Update de pet: valida APENAS o que está presente no doc resultante.
    // Um doc legado sem searchTokens/specifications/createdAt passa (batch
    // de telefone/backfill não derruba mais).
    function hasValidPetFields(doc) {
      return (!('ownerId' in doc) || isNonEmptyString(doc.ownerId))
        && (!('name' in doc) || isNonEmptyString(doc.name))
        && (!('age' in doc) || (doc.age is int && doc.age >= 0))
        && (!('ageUnit' in doc) || isNonEmptyString(doc.ageUnit))
        && (!('gender' in doc) || isNonEmptyString(doc.gender))
        && (!('address' in doc) || doc.address is string)
        && (!('ownerPhone' in doc) || doc.ownerPhone is string)
        && (!('ownerAddress' in doc) || doc.ownerAddress is string)
        && (!('description' in doc) || doc.description is string)
        && (!('publicationType' in doc) || isNonEmptyString(doc.publicationType))
        && (!('species' in doc) || isNonEmptyString(doc.species))
        && (!('race' in doc) || isNonEmptyString(doc.race))
        && (!('images' in doc) || doc.images is list)
        && (!('searchTokens' in doc) || isValidSearchTokens(doc.searchTokens))
        && (!('specifications' in doc) || doc.specifications is list)
        && (!('createdAt' in doc) || doc.createdAt is timestamp);
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && isValidUserCreate();
      allow read, delete: if isOwner(userId);
      allow update: if isOwner(userId) && hasValidUserFields(request.resource.data);
    }

    match /pets/{petId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidPetCreate();

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && hasValidPetFields(request.resource.data);

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}