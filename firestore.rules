rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Valida os campos sensíveis ao criar o usuário
    function isValidUserCreate() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.address is string;
    }

    // Valida os campos sensíveis de um pet.
    // ATENÇÃO: só usa em create/update. Em delete o request.resource
    // é null e acessá-lo nega a regra.
    function isValidPet() {
      return request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && request.resource.data.ageUnit is string
        && request.resource.data.gender is string
        && request.resource.data.images is list
        && request.resource.data.publicationType is string
        && request.resource.data.race is string
        && request.resource.data.species is string
        && request.resource.data.searchTokens is list;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && isValidUserCreate();
      allow read, update, delete: if isOwner(userId);
    }

    match /pets/{petId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidPet();

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && isValidPet();

      // DELETE: sem isValidPet() (request.resource é null) e sem
      // validação do "novo doc" — só confirma que o DONO está excluindo.
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}